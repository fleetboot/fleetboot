# Fleetboot control plane container.
#
# Runs the FastAPI dashboard + boot-session mint + registry.
# Registry SQLite lives in /data (volume-mounted). Boot artefacts
# (kernels, initrds, squashfs) live in /build (volume-mounted).
FROM python:3.13-slim AS runtime

# The fleetboot container is both the control plane AND the image
# builder. `make image` shells out to debos, which uses fakemachine
# to spin up a KVM guest for the actual mmdebstrap + mksquashfs
# work. That means the container needs:
#   - make (Makefile driver)
#   - debos + fakemachine (VM-orchestrated build)
#   - squashfs-tools, mmdebstrap (called from inside the fakemachine
#     guest, but present so debos can validate before launching)
#   - qemu-utils (fakemachine's KVM path)
#   - curl + ca-certificates (network fetches during setup-chroot)
#   - jq (helper commonly used in profile setup scripts)
# The host must pass /dev/kvm through — see docker-compose.yml.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
         make \
         ca-certificates \
         curl \
         jq \
         debos \
         fakemachine \
         squashfs-tools \
         mmdebstrap \
         qemu-utils \
         qemu-system-x86 \
         e2fsprogs \
         parted \
         dosfstools \
         kpartx \
         xz-utils \
         zstd \
         gzip \
         busybox-static \
         kmod \
    && rm -rf /var/lib/apt/lists/*

# Pre-create the `kvm` group inside the container so
# `group_add: - kvm` in docker-compose resolves. The build-time
# GID isn't required to match the host's — the container process
# runs as root and can open /dev/kvm regardless — but the group
# entry must exist by name for Docker to accept the group_add.
RUN groupadd -r kvm || true

WORKDIR /app

# Runtime deps only. Test deps (pytest etc.) are not needed in
# production.
RUN pip install --no-cache-dir \
    'fastapi[standard]' \
    'uvicorn[standard]' \
    httpx \
    pydantic \
    jinja2 \
    python-multipart

# fleetboot's tftp_glue imports tftpjail types (ClientIdentity).
# We install the sibling tftpjail package so the import surface
# resolves even in the control-plane container that never actually
# starts a TFTP server.
COPY tftpjail/tftpjail /app/tftpjail

COPY fleetboot/fleetboot /app/fleetboot
COPY fleetboot/image /app/image
COPY fleetboot/scripts /app/scripts
COPY fleetboot/Makefile /app/Makefile
COPY fleetboot/pyproject.toml /app/

ENV PYTHONPATH=/app
ENV FLEETBOOT_DB=/data/machines.sqlite
ENV FLEETBOOT_BOOT_DIR=/app/build
ENV FLEETBOOT_REPO_ROOT=/app

EXPOSE 8080

CMD ["python", "-m", "fleetboot.server"]
