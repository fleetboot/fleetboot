[Unit]
Description=Report login_console to the Fleetboot server
# Fires when the display manager has come up and the greeter is visible.
After=display-manager.service
Requires=display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -m fleetboot.reporter.report login_console

[Install]
WantedBy=graphical.target
