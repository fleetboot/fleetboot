[Unit]
Description=Set up local-disk scratch filesystem at /var/scratch
# Run after udev settles AND networking is up — needed because we
# call the reporter on success, and the reporter speaks HTTP to
# fleetboot. Also: /var/scratch isn't load-bearing for booting (live
# RAM root works without it), so deferring past network is cheap.
After=systemd-udevd.service systemd-udev-settle.service network-online.target fleetboot-network-up.service
Wants=systemd-udev-settle.service network-online.target
# Only when the cmdline explicitly enables a scratch mode (the
# fleetboot-scratch-setup.sh additionally honours the value).
ConditionKernelCommandLine=fleetboot.scratch

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/fleetboot/fleetboot-scratch-setup.sh
# Report success to fleetboot. Leading `-` so the reporter call
# failing (e.g. transient network) doesn't mark the unit failed —
# the next heartbeat re-sends the latest state anyway.
ExecStartPost=-/usr/bin/python3 -m fleetboot.reporter.report scratch_mounted

[Install]
WantedBy=multi-user.target
