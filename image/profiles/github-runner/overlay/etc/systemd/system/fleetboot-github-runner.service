[Unit]
Description=GitHub Actions self-hosted runner (ephemeral, one job per boot)
# The runner needs the network AND the reporter's network_up state
# (which proves DNS + gateway are reachable — otherwise the runner's
# first HTTPS call to github.com would fail with a confusing error).
After=network-online.target fleetboot-network-up.service
Wants=network-online.target
# Only bother trying if the cmdline actually has a boot token — the
# runtime script needs it to fetch a registration token from fleetboot.
ConditionKernelCommandLine=fleetboot.boot_token

[Service]
Type=simple
# Root here — the wrapper opens /dev/tty1 (and /dev/ttyS0 when
# serial console is enabled) so admins with a monitor or cable see
# every step live. The wrapper drops privileges to the `runner`
# user with `runuser` before invoking config.sh / run.sh, so the
# actions/runner itself never runs as root.
User=root
WorkingDirectory=/opt/actions-runner
ExecStart=/usr/local/lib/fleetboot/register-github-runner.sh
# Persistent runner: config once, run forever. If run.sh dies (job
# error, GitHub disconnect, config expiry) we restart the whole
# script so it re-registers with a fresh token. --ephemeral runners
# are a mode for the workflow to opt into, not something we bake in.
Restart=on-failure
RestartSec=15s

[Install]
WantedBy=multi-user.target
