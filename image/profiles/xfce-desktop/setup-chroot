#!/bin/sh
# Make the image boot into the graphical target. The base recipe leaves
# the default at multi-user.target (text console) — a desktop profile
# needs to opt in.
set -eu
systemctl set-default graphical.target
# policy-rc.d in the chroot build prevents lightdm's postinst from
# auto-enabling the service. Enable explicitly so display-manager.service
# is wanted by graphical.target and starts at boot.
systemctl enable lightdm.service
