# /etc/exports — fleetboot's Kerberos-secured NFSv4 exports.
#
# Generated by scripts/setup-nfs-server.sh. Edit the template if you
# need to change the export options globally.
#
# fsid=0 is the NFSv4 pseudo-root. Everything else is reachable beneath
# it. Clients mount /export/home or /export/shared via autofs maps in
# the image.
#
# sec=krb5p means traffic is *encrypted* under the user's Kerberos
# credential — the strongest of NFSv4's options. Anything weaker (krb5,
# krb5i) gives integrity but not confidentiality; sys is unauthenticated
# and lets any host on the LAN forge a uid.

/export                    *(rw,sync,fsid=0,crossmnt,no_subtree_check,sec=krb5p)
/export/home               *(rw,sync,no_subtree_check,sec=krb5p)
/export/shared             *(rw,sync,no_subtree_check,sec=krb5p)
