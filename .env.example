# Copy to `.env` and fill in per-deployment.
#
#   cp .env.example .env
#   # then edit .env with real values
#
# `docker compose up` reads .env automatically.

# ---- Required ----

# Dashboard login password. `admin` is the fixed username.
FLEETBOOT_ADMIN_SECRET=change-me-to-a-long-random-string

# Shared secret between fleetboot and tftpjail. Must match on both.
FLEETBOOT_MINT_SECRET=change-me-to-a-different-long-random-string

# The URL a booted-and-DHCP'd machine on your LAN can reach the
# fleetboot control plane at. Baked into every grub.cfg the
# tftpjail service renders — clients cannot boot without a working
# CLIENT_BASE_URL. Typically your host's LAN IP + fleetboot port.
CLIENT_BASE_URL=http://192.168.1.50:8080

# ---- Optional ----

# Port fleetboot's HTTP + dashboard bind to on the host. Default 8080.
# FLEETBOOT_PORT=8080

# TFTP port. Default 69 (privileged). Change if you're running compose
# without CAP_NET_BIND_SERVICE or want to test on a high port.
# TFTP_PORT=69

# Log verbosity. debug|info|warning|error. Default info.
# FLEETBOOT_LOG_LEVEL=info
# TFTPJAIL_LOG_LEVEL=info

# Optional TLS for the fleetboot dashboard + API. Drop a PEM cert +
# matching key into `tls/` next to this file, then point these at the
# in-container paths (`/tls/<file>` is where the bind-mount lands).
# Leaving them unset serves plain HTTP.
# FLEETBOOT_TLS_CERT=/tls/fleetboot.crt
# FLEETBOOT_TLS_KEY=/tls/fleetboot.key

# ---- Optional: FreeIPA identity server (docker compose --profile ipa) ----
#
# Only needed if you bring up the `ipa` compose profile. Not coupled to
# fleetboot — booted machines whose profile bakes in an enroll-freeipa
# step (see image/identity/) can enrol against this instance or against
# any other IPA server.

# FQDN the IPA server answers on. MUST be resolvable both directions
# (forward + reverse) from every classroom PC. Point your existing DNS
# at IPA_SERVER_IP before bringing the container up.
# IPA_SERVER_HOSTNAME=ipa.realm.example.com

# LAN IP the container publishes on. Typically the same host address
# as CLIENT_BASE_URL points at.
# IPA_SERVER_IP=192.168.1.50

# Kerberos realm (traditionally upper-case) and its DNS domain.
# IPA_REALM=REALM.EXAMPLE.COM
# IPA_DOMAIN=realm.example.com

# Directory Manager AND admin password on first install. Rotate the
# admin password inside FreeIPA later; this env var is only consulted
# during the initial `ipa-server-install` on first `up`.
# IPA_ADMIN_PASSWORD=change-me-to-a-long-random-string

# ---- Optional: Kerberised NFSv4 server (docker compose --profile nfs) ----
#
# Serves /export/home + /export/shared under sec=krb5p. Consumes
# IPA_DOMAIN (above) as its NFSv4 idmap Domain and expects a keytab
# at NFS_KEYTAB_HOST_PATH.

# Where /export lives on the host. Home dirs land at
# <path>/home/<user>; shared trees at <path>/shared/*.
# NFS_EXPORT_HOST_PATH=/srv/fleetboot/nfs/export

# Path on the host to a keytab for nfs/<compose-host-fqdn>@REALM.
# Obtain via `ipa-getkeytab` from an IPA-enrolled host.
# NFS_KEYTAB_HOST_PATH=./tls-keytabs/nfs.keytab

# Kernel NFSD thread count. 8 is fine for a couple of classrooms.
# NFSD_THREADS=8
