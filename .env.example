# Copy to `.env` and fill in per-deployment.
#
#   cp .env.example .env
#   # then edit .env with real values
#
# `docker compose up` reads .env automatically.

# ---- Required ----

# Dashboard login password. `admin` is the fixed username.
FLEETBOOT_ADMIN_SECRET=change-me-to-a-long-random-string

# Shared secret between fleetboot and tftpjail. Must match on both.
FLEETBOOT_MINT_SECRET=change-me-to-a-different-long-random-string

# The URL a booted-and-DHCP'd machine on your LAN can reach the
# fleetboot control plane at. Baked into every grub.cfg the
# tftpjail service renders — clients cannot boot without a working
# CLIENT_BASE_URL. Typically your host's LAN IP + fleetboot port.
CLIENT_BASE_URL=http://192.168.1.50:8080

# ---- Optional ----

# Port fleetboot's HTTP + dashboard bind to on the host. Default 8080.
# FLEETBOOT_PORT=8080

# TFTP port. Default 69 (privileged). Change if you're running compose
# without CAP_NET_BIND_SERVICE or want to test on a high port.
# TFTP_PORT=69

# Log verbosity. debug|info|warning|error. Default info.
# FLEETBOOT_LOG_LEVEL=info
# TFTPJAIL_LOG_LEVEL=info

# Path to a fleetid checkout, mounted at /fleetid in the container so
# fleetid's composable `freeipa` image profile resolves for builds
# started from the dashboard or MCP (those run `make image` inside the
# container). Only needed if your profile tree symlinks in that profile.
# Absolute paths are clearest. Defaults to an empty placeholder.
# FLEETID_DIR=/opt/fleetboot/fleetid

# Optional TLS for the fleetboot dashboard + API. Drop a PEM cert +
# matching key into `tls/` next to this file, then point these at the
# in-container paths (`/tls/<file>` is where the bind-mount lands).
# Leaving them unset serves plain HTTP.
# FLEETBOOT_TLS_CERT=/tls/fleetboot.crt
# FLEETBOOT_TLS_KEY=/tls/fleetboot.key

# ---- Central identity + Kerberos NFS homes ------------------------------
#
# These are NOT part of fleetboot. The FreeIPA identity server and the
# Kerberos NFSv4 home-directory server are the separate `fleetid` project
# (../fleetid), which ships its own docker-compose stack and a composable
# `freeipa` image profile. Stand them up from there; fleetboot only needs
# to register the machines (which it already does) and deliver each
# machine's enrolment keytab over /enrol/<token>/keytab.
